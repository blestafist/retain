# SQLite database file. The directory must be writable by the Retain process.
DATABASE_PATH=/data/retain.db

# HTTP listen address.
HTTP_ADDR=:8080

# Canonical public origin. Replace this placeholder with the deployed origin.
PUBLIC_ORIGIN=https://retain.example.com

# Optional OpenAI-compatible LLM endpoint. Leave LLM_BASE_URL empty to disable
# LLM features. The API key is required when a base URL is configured.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=cx/gpt-6-luna
# Optional fast model for bulk enrichment; when empty, use LLM_MODEL.
LLM_MODEL_FAST=
LLM_TIMEOUT=30s
LLM_DAILY_LIMIT_PER_USER=300

# Optional Web Push reminders. Leave all three empty to disable push.
# Generate a VAPID key pair once and keep the private key server-side only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# An email address (optionally prefixed with mailto:) or an HTTPS contact URL.
VAPID_SUBJECT=
